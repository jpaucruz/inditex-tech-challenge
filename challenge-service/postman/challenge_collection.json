                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Applicable price is correct', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.productId).to.eql(Number(pm.collectionVariables.get('productId')));",
                  "    pm.expect(body.brandId).to.eql(Number(pm.collectionVariables.get('brandId')));",
                  "    pm.expect(body.priceList).to.eql(1);",
                  "    pm.expect(Number(body.price)).to.eql(35.5);",
                  "    pm.expect(body.currency).to.eql('EUR');",
                  "});"
                ]
              }
            }
